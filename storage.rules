rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/renovo_plus_users/$(request.auth.uid)).data;
    }

    function isActiveProfile() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/renovo_plus_users/$(request.auth.uid))
        && profile().status == "active";
    }

    function isAdminOrPastor() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/renovo_plus_users/$(request.auth.uid))
        && profile().status == "active"
        && (
          profile().role == "admin"
          || profile().role == "pastor"
          || profile().role == "coordinator"
        );
    }

    match /studies/{allPaths=**} {
      allow read, write: if true;
    }

    match /renovo-plus/studies/{studyId}/{fileName} {
      allow read: if isActiveProfile();
      allow write: if isAdminOrPastor();
    }

    match /renovo-plus/reports/{reportId}/{fileName} {
      allow read: if isActiveProfile();
      allow write: if isActiveProfile();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
